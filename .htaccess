<IfModule mod_rewrite.c>
  Options +FollowSymlinks -Multiviews
  RewriteEngine On

  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.*)$ index.php/$1 [QSA,PT,L]
</IfModule>

# Block access to sensitive directories
<IfModule mod_rewrite.c>
  RewriteRule ^(app|config|route|database|runtime|extend|vendor|githooks)/ - [F,L]
  RewriteRule ^\.env - [F,L]
  RewriteRule ^\.example\.env - [F,L]
  RewriteRule ^\.git - [F,L]
  RewriteRule ^composer\.(json|lock) - [F,L]
  RewriteRule ^think$ - [F,L]
</IfModule>

# Block direct access to PHP files (except index.php and router.php)
<FilesMatch "\.(php|php5|phtml|inc)$">
  Order Allow,Deny
  Deny from all
</FilesMatch>

<FilesMatch "^(index|router)\.php$">
  Order Allow,Deny
  Allow from all
</FilesMatch>

# Block access to hidden files
<FilesMatch "^\.(env|example|git|htaccess|gitignore)">
  Order Allow,Deny
  Deny from all
</FilesMatch>
